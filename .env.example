# Server Port (Render automatically sets PORT=10000 in production)
PORT=10000

# Node Environment
NODE_ENV=production

# Allowed CORS Origins (* for open access, or comma-separated list of domains)
CORS_ORIGIN=*

# Self-Ping URL for Render keep-alive (Optional: if set, backend pings itself every 10 minutes)
# Example: https://guess-the-frame-server.onrender.com
RENDER_EXTERNAL_URL=
